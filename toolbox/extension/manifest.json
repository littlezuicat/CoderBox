{
  "manifest_version": 3,
  "name": "码境密码",
  "version": "0.1.0",
  "description": "用码境工具箱的本机密码库自动填充登录（密码只在你点选或匹配网址时才取出）",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "码境密码",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "fill": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "填充当前页面的登录"
    }
  }
}